# Backend API Config
# 빌드 타임에 인라인됨(클라이언트+서버 공용). 로컬 개발 시 localhost:8080으로 변경
# 프로덕션 Cloud Run 배포는 cloudbuild.yaml의 --build-arg / --set-env-vars로 자동 주입됨
NEXT_PUBLIC_API_URL="https://tones-server-257637179317.us-central1.run.app"

# Google Gemini Config
# Server Actions(chat.ts)에서 Gemini 2.5-flash 직접 호출 시 사용
GEMINI_API_KEY="your-gemini-api-key"
